{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tom-bcs.github.io/open-golf-course-maps/schema/index.schema.json",
  "title": "Region index",
  "description": "<region>/index.json: one entry per course in a region. See docs/schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attribution", "region", "dataTimestamp", "courseCount", "courses"],
  "properties": {
    "schema": { "const": 1 },
    "attribution": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$" },
    "dataTimestamp": { "type": ["string", "null"] },
    "courseCount": { "type": "integer", "minimum": 0 },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "club", "status", "holeCount", "parComplete", "centre", "bounds", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": ["string", "null"] },
          "club": { "type": ["string", "null"] },
          "status": { "enum": ["ready", "partial", "outline"] },
          "holeCount": { "type": "integer", "minimum": 0 },
          "parComplete": { "type": "boolean" },
          "centre": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "type": "number", "minimum": -90, "maximum": 90 },
              { "type": "number", "minimum": -180, "maximum": 180 }
            ]
          },
          "bounds": {
            "description": "[south, west, north, east]",
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "file": { "type": "string", "pattern": "^courses/[a-z0-9][a-z0-9-]*\\.json$" }
        }
      }
    }
  }
}
