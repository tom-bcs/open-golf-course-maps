{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tom-bcs.github.io/open-golf-course-maps/schema/regions.schema.json",
  "title": "Regions",
  "description": "regions.json at the site root: every region built. See docs/schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "attribution", "regions"],
  "properties": {
    "schema": { "const": 1 },
    "attribution": { "type": "string", "minLength": 1 },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "index", "courseCount", "statusCounts", "bounds", "dataTimestamp"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$" },
          "index": { "type": "string", "pattern": "/index\\.json$" },
          "courseCount": { "type": "integer", "minimum": 0 },
          "statusCounts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ready", "partial", "outline"],
            "properties": {
              "ready": { "type": "integer", "minimum": 0 },
              "partial": { "type": "integer", "minimum": 0 },
              "outline": { "type": "integer", "minimum": 0 }
            }
          },
          "bounds": {
            "description": "[south, west, north, east] over every course in the region, or null if it has none.",
            "oneOf": [
              { "type": "null" },
              { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } }
            ]
          },
          "dataTimestamp": { "type": ["string", "null"] }
        }
      }
    }
  }
}
